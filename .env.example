# REUSE the actual .env from your existing Desktop/ALMA folder.
# Never publish or share your real values.
OPENAI_API_KEY=YOUR_PRIVATE_OPENAI_API_KEY
ALMA_VECTOR_STORE_IDS=vs_FIRST_ID,vs_SECOND_ID,vs_THIRD_ID
# For a single old library, ALMA_VECTOR_STORE_ID=vs_... also works.
ALMA_MODEL=gpt-5.4-mini
